{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the tray panel",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "global-shortcut:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8787/**" },
        { "url": "http://127.0.0.1:8787/**" },
        { "url": "https://hauntshot.com/**" },
        { "url": "https://www.hauntshot.com/**" },
        { "url": "https://*.hauntshot.app/**" },
        { "url": "https://*.hauntshot.com/**" },
        { "url": "https://hauntshot-api.hauntshot.workers.dev/**" }
      ]
    }
  ]
}
