{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HauntShot",
  "version": "1.0.0",
  "identifier": "app.hauntshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HauntShot",
        "width": 360,
        "height": 480,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "HauntShot",
        "width": 300,
        "height": 62,
        "resizable": false,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist.overlay"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREQkVBOUM0NjFGQTc0QTUKUldTbGRQcGh4S20rVGVrZ0VVSE05TEw0UFRIR1ZxUUVvUjlOeWpzYlgyR21kbDE2bGtwNmFvZGwK",
      "endpoints": [
        "https://hauntshot.com/updates/latest.json",
        "https://github.com/stormageddon/HauntShot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
