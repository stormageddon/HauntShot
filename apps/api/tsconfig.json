{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts", "@types/node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@hauntshot/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "migrations"]
}
