/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hauntshot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "workers_dev": true,
  // Apex/www still have parking DNS from zone setup — Worker custom domains
  // cannot attach until those A/CNAME records are deleted in the dashboard.
  // share/api/app were attached via the Workers Domains API.
  "routes": [
    { "pattern": "share.hauntshot.com", "custom_domain": true },
    { "pattern": "api.hauntshot.com", "custom_domain": true },
    { "pattern": "app.hauntshot.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hauntshot",
      "database_id": "c3ae95ab-29f5-4d09-9937-47c7c5a92992",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hauntshot-shots"
    }
  ]
}
