/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hauntshot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  // workers.dev stays up as a fallback while nameservers propagate and for
  // anyone still holding an old build.
  "workers_dev": true,
  // Apex + www serve the API and viewer. Custom domains require the zone on
  // Cloudflare; wrangler creates the proxied DNS records on deploy.
  "routes": [
    { "pattern": "hauntshot.com", "custom_domain": true },
    { "pattern": "www.hauntshot.com", "custom_domain": true }
  ],
  // Pinned: the desktop client defaults to 127.0.0.1:8787, and wrangler
  // otherwise slides to the next free port when one is already bound.
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hauntshot",
      "database_id": "c3ae95ab-29f5-4d09-9937-47c7c5a92992",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hauntshot-shots"
    }
  ]
}
